[gd_resource type="Shader" format=3 uid="uid://bwyh7lnyehx8p"]

[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_toon, specular_toon, ambient_light_disabled;

uniform sampler2D albedo_texture : source_color, filter_linear;
uniform sampler2D color_gradient;
uniform sampler2D fresnal_gradient;

float fresnal(float ammount, vec3 normal, vec3 view){
	return pow((1.0 - clamp(dot(normalize(normal), normalize(view)), 0.0, 1.0)), ammount);
}

void vertex() {
	// Called for every vertex the material is visible on.
	//UV = vec2(1, 1);
}

void fragment() {
	// Called for every pixel the material is visible on.
	//float basic_fresnal = fresnal(4.0, NORMAL, VIEW);
	//ALBEDO = texture(albedo_texture, UV).rgb + (basic_fresnal * texture(fresnal_gradient, vec2(basic_fresnal, 0.0)).rgb * 1.0);
	ALBEDO = texture(albedo_texture, UV).rgb;
	
}

void light() {
	// Called for every pixel for every light affecting the material.
	// Uncomment to replace the default light processing function with this one.
	float dotProduct = clamp(dot(NORMAL, LIGHT), -0.9, 0.9);
	float sample = clamp((dotProduct + 1.0) * ATTENUATION / 2.1, 0.05, 0.95);
	vec4 shaded = texture(color_gradient, vec2(sample, 0.0));
	
	DIFFUSE_LIGHT += clamp((shaded.rgb * LIGHT_COLOR), 0.0, 1.0);
}
"
